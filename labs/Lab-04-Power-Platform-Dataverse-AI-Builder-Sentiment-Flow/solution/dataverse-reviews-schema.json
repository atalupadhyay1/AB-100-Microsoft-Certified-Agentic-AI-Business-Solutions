{
  "tableSchemaName": "bfyo_CustomerReview",
  "displayName": "Customer Review",
  "pluralDisplayName": "Customer Reviews",
  "description": "Stores customer product reviews, AI Builder sentiment classifications, confidence scores, and quality assurance escalation statuses for Best For You Organics Company.",
  "primaryNameAttribute": "bfyo_reviewnumber",
  "enableAuditing": true,
  "enableTrackChanges": true,
  "columns": [
    {
      "logicalName": "bfyo_reviewnumber",
      "displayName": "Review Number",
      "dataType": "AutoNumber",
      "format": "REV-{SEQNUM:5}",
      "description": "Unique auto-generated identifier for the customer product review."
    },
    {
      "logicalName": "bfyo_customername",
      "displayName": "Customer Name",
      "dataType": "String",
      "maxLength": 150,
      "description": "Full name of the customer submitting the organic product review."
    },
    {
      "logicalName": "bfyo_customeremail",
      "displayName": "Customer Email",
      "dataType": "String",
      "format": "Email",
      "maxLength": 200,
      "description": "Email address used for automated follow-up when a negative product review is resolved."
    },
    {
      "logicalName": "bfyo_productsku",
      "displayName": "Product SKU",
      "dataType": "String",
      "maxLength": 50,
      "description": "Stock Keeping Unit (SKU) code of the organic product reviewed by the customer."
    },
    {
      "logicalName": "bfyo_reviewtext",
      "displayName": "Review Text",
      "dataType": "Memo",
      "maxLength": 4000,
      "description": "Unstructured verbatim customer feedback text analyzed by AI Builder Sentiment Analysis."
    },
    {
      "logicalName": "bfyo_sentimentclassification",
      "displayName": "Sentiment Classification",
      "dataType": "Picklist",
      "options": [
        { "value": 100000000, "label": "Positive" },
        { "value": 100000001, "label": "Neutral" },
        { "value": 100000002, "label": "Negative" }
      ],
      "description": "Overall sentiment label (Positive, Neutral, or Negative) predicted by AI Builder."
    },
    {
      "logicalName": "bfyo_confidencescore",
      "displayName": "Confidence Score",
      "dataType": "Decimal",
      "minValue": 0.0,
      "maxValue": 1.0,
      "precision": 4,
      "description": "Probability confidence score (0.0000 to 1.0000) returned by the AI Builder sentiment model."
    },
    {
      "logicalName": "bfyo_aisummaryandrootcause",
      "displayName": "AI Summary and Root Cause",
      "dataType": "Memo",
      "maxLength": 2000,
      "description": "Structured root-cause summary generated by the AI Builder Custom Prompt Action."
    },
    {
      "logicalName": "bfyo_escalationstatus",
      "displayName": "Escalation Status",
      "dataType": "Picklist",
      "options": [
        { "value": 100000000, "label": "Not Required" },
        { "value": 100000001, "label": "Pending QA Review" },
        { "value": 100000002, "label": "Resolved" }
      ],
      "description": "Tracks whether a high-confidence negative review requires human Quality Assurance intervention."
    }
  ]
}
